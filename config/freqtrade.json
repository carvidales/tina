{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "tina-paper",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "trading_mode": "spot",
  "margin_mode": "",
  "stake_currency": "EUR",
  "stake_amount": 100,
  "tradable_balance_ratio": 0.95,
  "fiat_display_currency": "EUR",
  "max_open_trades": 2,
  "timeframe": "15m",
  "strategy": "TinaStrategy",
  "initial_state": "running",
  "force_entry_enable": false,
  "position_adjustment_enable": false,
  "cancel_open_orders_on_exit": true,
  "unfilledtimeout": {"entry": 1, "exit": 5, "exit_timeout_count": 0, "unit": "minutes"},
  "entry_pricing": {"price_side": "same", "use_order_book": true, "order_book_top": 1, "price_last_balance": 0.0},
  "exit_pricing": {"price_side": "other", "use_order_book": true, "order_book_top": 1},
  "order_types": {"entry": "limit", "exit": "limit", "emergency_exit": "market", "force_exit": "market", "force_entry": "limit", "stoploss": "market", "stoploss_on_exchange": false},
  "order_time_in_force": {"entry": "GTC", "exit": "GTC"},
  "exchange": {
    "name": "kraken", "key": "", "secret": "",
    "ccxt_config": {"enableRateLimit": true}, "ccxt_async_config": {},
    "pair_whitelist": ["BTC/EUR", "ETH/EUR"], "pair_blacklist": []
  },
  "pairlists": [{"method": "StaticPairList"}],
  "telegram": {"enabled": false},
  "api_server": {
    "enabled": true, "listen_ip_address": "0.0.0.0", "listen_port": 8080,
    "verbosity": "error", "enable_openapi": false, "CORS_origins": [],
    "username": "tina", "password": "", "jwt_secret_key": ""
  },
  "internals": {"process_throttle_secs": 5}
}
